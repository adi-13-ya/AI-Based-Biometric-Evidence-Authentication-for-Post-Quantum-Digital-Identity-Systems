# ---------------------------------------------------------------------------
# PQ-Biometric-Auth configuration
# Copy this file to .env and adjust as needed. All values here have sane
# defaults baked into the code (see server/config.py) so the app runs even
# if .env is missing - this file documents every tunable.
# ---------------------------------------------------------------------------

# --- PQC algorithm selection (Section 5) ---
# NIST Level 3 (recommended default: good security/performance balance)
KEM_ALG=ML-KEM-768
SIG_ALG=ML-DSA-65

# NIST Level 5 alternative - uncomment to measure the heavier overhead
# KEM_ALG=ML-KEM-1024
# SIG_ALG=ML-DSA-87

# Enable the classical (RSA-3072 / ECDSA-P256) code path for side-by-side
# overhead comparison in evaluation/benchmark.py
ENABLE_CLASSICAL_BASELINE=true

# --- Session binding / freshness (Section 7) ---
FRESHNESS_WINDOW_SECONDS=30
NONCE_BYTES=32

# --- Detection thresholds (Section 6.6, fusion) ---
# Per-module threshold. Each one is a separate veto: a submission is ACCEPTed
# only if EVERY module scores >= its own threshold (detection/fusion.py).
# PAD/deepfake/injection values are the operating points chosen on development
# data by evaluation/benchmark_pad.py, benchmark_deepfake.py, train_injection.py.
THRESHOLD_PRESENTATION_ATTACK=0.57
THRESHOLD_MORPH=0.5
THRESHOLD_DEEPFAKE=0.48
THRESHOLD_REPLAY=0.5
THRESHOLD_INJECTION=0.39

# Weights of the reported (threshold-normalised) weighted mean. The mean is
# for display and logs only; it does not decide ACCEPT/REJECT.
WEIGHT_PRESENTATION_ATTACK=0.25
WEIGHT_MORPH=0.20
WEIGHT_DEEPFAKE=0.25
WEIGHT_REPLAY=0.15
WEIGHT_INJECTION=0.15

# --- Detection model mode ---
# "pretrained" tries to load real checkpoints (see detection/README-models.md);
# "mock" uses deterministic heuristic stand-ins - used automatically as a
# fallback if a checkpoint fails to load, can also be forced for CI/offline dev.
DETECTION_MODE=pretrained
# MiniFASNet checkpoints: "released" (default) or "finetuned" (CASIA-FASD)
PAD_WEIGHTS=released
# "integrated" (default) or "layered" (ablation: AI before crypto checks)
PIPELINE_MODE=integrated
DETECTOR_DEVICE=cpu

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# true enables POST /demo/reset-replay-store (forget seen evidence between
# demo rehearsals). Never enable outside a demo.
DEMO_MODE=false
# true accepts single images and short clips from demo_assets/ (the Attack
# samples tab and scripts/demo_check.py) and relaxes the liveness check to a
# response-only fallback when motion cannot be measured. Demo rehearsals only.
# Live webcam capture always has the strict layout and does not need it.
ALLOW_SAMPLE_UPLOADS=false

# --- Sessions and submission limits (docs/PROTOCOL.md) ---
REQUIRE_SIGNED_SESSION_START=true
SESSION_TTL_SECONDS=120
MAX_ACTIVE_SESSIONS_PER_DEVICE=3
MAX_SESSIONS_PER_MINUTE_PER_DEVICE=12
# motion = head turn / nod; add ",digits" for the typed spoken-digit prompt
# (no audio check: binds the session but is not a liveness test)
CHALLENGE_KINDS=motion
SPREAD_FRAMES=8
BURST_FRAMES=8
MAX_FRAME_PIXELS=2073600
MAX_BODY_BYTES=50331648
PAD_FRAMES=3

# --- Replay detector store ---
REPLAY_HASH_WINDOW_SECONDS=86400

# --- Client demo (Streamlit, runs natively on Windows) ---
API_BASE_URL=http://localhost:8000
